    local {
      auth = psk
      id   = ipsec-a
    }
    remote {
      auth = psk
      id   = ipsec-b
    }
    children {
      net {
        local_ts      = 10.1.1.0/24
        remote_ts     = 10.2.2.0/24
        esp_proposals = aes256gcm16-x25519
        rekey_time    = 5m
        start_action  = trap
        hw_offload    = no
      }
    }
  }
}
secrets {
  ike-lab {
    id-a   = ipsec-a
    id-b   = ipsec-b
    secret = "pre-shared-key"
  }
}


